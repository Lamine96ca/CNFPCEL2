# CNFPCEL — modèle du fichier .env
# Copier ce fichier en « .env » à la racine du projet (poste de développement ou serveur),
# puis remplir les valeurs. Le fichier .env n'est JAMAIS envoyé sur Git (il contient des mots de passe).

# --- Mode et sécurité ---------------------------------------------------------
# 1 en développement, 0 en production
CNFPCEL_DEBUG=0
# Clé secrète : une longue chaîne aléatoire, différente sur chaque machine.
# La générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
CNFPCEL_SECRET_KEY=
# Domaines du site, séparés par des virgules
CNFPCEL_ALLOWED_HOSTS=cnfpcel.gov.gn,www.cnfpcel.gov.gn,cn.cnfpcel.com
# Domaine principal : les autres adresses (www, cn.cnfpcel.com) y sont redirigées. Vide en développement.
CNFPCEL_DOMAINE_PRINCIPAL=cnfpcel.gov.gn
# Adresse publique du site (liens dans les e-mails)
CNFPCEL_URL_PUBLIQUE=https://cnfpcel.gov.gn
# HSTS : laisser 0 au début ; mettre 31536000 (1 an) une fois le HTTPS vérifié partout
CNFPCEL_HSTS_SECONDES=0

# --- Base MySQL ----------------------------------------------------------------
# Chez o2switch (cPanel → Bases de données MySQL), la base et l'utilisateur commencent
# par l'identifiant cPanel, ex. vazi2419_cnfpcel. En local (WAMP) : cnfpcel / root / (vide).
CNFPCEL_DB_NAME=vazi2419_cnfpcel
CNFPCEL_DB_USER=vazi2419_cnfpcel
CNFPCEL_DB_PASSWORD=
CNFPCEL_DB_HOST=localhost
CNFPCEL_DB_PORT=3306

# --- E-mails --------------------------------------------------------------------
# Sans CNFPCEL_EMAIL_HOST, les e-mails ne partent pas : ils s'affichent dans la console.
# La boîte noreply@cnfpcel.gov.gn est hébergée chez SiteGround.
CNFPCEL_EMAIL_HOST=mail.cnfpcel.gov.gn
CNFPCEL_EMAIL_PORT=465
# 1 = SSL (port 465) ; sinon mettre 0 et CNFPCEL_EMAIL_TLS=1 (port 587)
CNFPCEL_EMAIL_SSL=1
CNFPCEL_EMAIL_TLS=0
CNFPCEL_EMAIL_USER=noreply@cnfpcel.gov.gn
CNFPCEL_EMAIL_PASSWORD=
CNFPCEL_EMAIL_FROM=CNFPCEL <noreply@cnfpcel.gov.gn>
